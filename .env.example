# Copie para .env se quiser trocar algum valor. Há padrão para tudo no docker-compose.yml.

# Senha do superusuário do Postgres (o container de banco).
POSTGRES_PASSWORD=postgres

# Segredo usado pelo Gateway para assinar e validar o JWT.
JWT_SECRET=arenahub-dev-secret-change-me

# Administrador inicial, criado na subida do Gateway de forma idempotente.
# O cadastro público NUNCA cria um ADM: esta é a única porta de entrada.
ADMIN_EMAIL=admin@arenahub.local
ADMIN_SENHA=arenahub123
ADMIN_NOME=Administrador
