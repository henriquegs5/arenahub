{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipe.rejeitada.v1",
  "title": "EquipeRejeitada (v1)",
  "description": "Resposta da Saga de inscrição: a equipe não é elegível. O Torneios compensa e libera a vaga. Publicado por equipes. Consumido por: torneios. Routing key: equipe.rejeitada.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "equipe.rejeitada"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "equipes"
    },
    "payload": {
      "type": "object",
      "required": [
        "inscricaoId",
        "torneioId",
        "equipeId",
        "motivo"
      ],
      "properties": {
        "inscricaoId": {
          "type": "string",
          "format": "uuid"
        },
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "equipeId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeEquipe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "capitaoId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "motivo": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
