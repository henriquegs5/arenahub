{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resultado.contestado.v1",
  "title": "ResultadoContestado (v1)",
  "description": "Publicado por Partidas. Consumido por: Notificações. Routing key: resultado.contestado.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "resultado.contestado"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "partidas"
    },
    "payload": {
      "type": "object",
      "required": [
        "partidaId",
        "torneioId",
        "contestadoPor",
        "motivo"
      ],
      "properties": {
        "partidaId": {
          "type": "string"
        },
        "torneioId": {
          "type": "string"
        },
        "contestadoPor": {
          "type": "string"
        },
        "motivo": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}