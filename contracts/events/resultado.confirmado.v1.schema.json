{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resultado.confirmado.v1",
  "title": "ResultadoConfirmado (v1)",
  "description": "O placar virou oficial. O Torneios avança a chave e o Ranking soma os pontos. Publicado por partidas. Consumido por: torneios, ranking, notificacoes. Routing key: resultado.confirmado.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "resultado.confirmado"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "partidas"
    },
    "payload": {
      "type": "object",
      "required": [
        "partidaId",
        "torneioId",
        "nomeTorneio",
        "rodada",
        "equipeAId",
        "equipeBId",
        "nomeEquipeA",
        "nomeEquipeB",
        "placarA",
        "placarB",
        "destinatarios"
      ],
      "properties": {
        "partidaId": {
          "type": "string",
          "format": "uuid"
        },
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeTorneio": {
          "type": "string"
        },
        "rodada": {
          "type": "integer"
        },
        "equipeAId": {
          "type": "string",
          "format": "uuid"
        },
        "equipeBId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeEquipeA": {
          "type": "string"
        },
        "nomeEquipeB": {
          "type": "string"
        },
        "placarA": {
          "type": "integer"
        },
        "placarB": {
          "type": "integer"
        },
        "vencedorId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "nomeVencedor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
