{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "membro.entrou.v1",
  "title": "MembroEntrou (v1)",
  "description": "Um jogador passou a integrar a equipe. Publicado por equipes. Consumido por: notificacoes. Routing key: membro.entrou.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "membro.entrou"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "equipes"
    },
    "payload": {
      "type": "object",
      "required": [
        "equipeId",
        "nomeEquipe",
        "usuarioId",
        "nomeUsuario",
        "membros",
        "destinatarios"
      ],
      "properties": {
        "equipeId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeEquipe": {
          "type": "string"
        },
        "usuarioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeUsuario": {
          "type": "string"
        },
        "membros": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
