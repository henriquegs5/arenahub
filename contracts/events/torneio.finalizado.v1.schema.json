{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "torneio.finalizado.v1",
  "title": "TorneioFinalizado (v1)",
  "description": "O torneio terminou e tem campeã. Publicado por torneios. Consumido por: equipes, ranking, notificacoes. Routing key: torneio.finalizado.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "torneio.finalizado"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "torneios"
    },
    "payload": {
      "type": "object",
      "required": [
        "torneioId",
        "nomeTorneio",
        "campeaoId",
        "nomeCampeao",
        "formato",
        "destinatarios"
      ],
      "properties": {
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeTorneio": {
          "type": "string"
        },
        "campeaoId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeCampeao": {
          "type": "string"
        },
        "formato": {
          "type": "string",
          "enum": [
            "ELIMINACAO_SIMPLES",
            "PONTOS_CORRIDOS"
          ]
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
