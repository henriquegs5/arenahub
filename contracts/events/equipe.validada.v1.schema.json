{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipe.validada.v1",
  "title": "EquipeValidada (v1)",
  "description": "Resposta da Saga de inscrição: a equipe é elegível. Carrega os membros para que o Torneios saiba a quem avisar. Publicado por equipes. Consumido por: torneios, ranking. Routing key: equipe.validada.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "equipe.validada"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "equipes"
    },
    "payload": {
      "type": "object",
      "required": [
        "inscricaoId",
        "torneioId",
        "equipeId",
        "nomeEquipe",
        "capitaoId",
        "membros"
      ],
      "properties": {
        "inscricaoId": {
          "type": "string",
          "format": "uuid"
        },
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "equipeId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeEquipe": {
          "type": "string"
        },
        "capitaoId": {
          "type": "string",
          "format": "uuid"
        },
        "membros": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
