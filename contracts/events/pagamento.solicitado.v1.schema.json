{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pagamento.solicitado.v1",
  "title": "PagamentoSolicitado (v1)",
  "description": "Passo 3 da Saga: lugares reservados, cobranca pedida. Publicado por ingressos. Consumido por: pagamento. SEGURANCA: trafega apenas referenciaPagamento, um token opaco. Numero de cartao, CVV e validade NUNCA entram neste sistema. Routing key: pagamento.solicitado.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "pagamento.solicitado"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "ingressos"
    },
    "payload": {
      "type": "object",
      "required": [
        "pedidoId",
        "eventoId",
        "compradorId",
        "valorCentavos",
        "meio",
        "referenciaPagamento",
        "eventoNome",
        "destinatarios"
      ],
      "properties": {
        "pedidoId": {
          "type": "string",
          "format": "uuid"
        },
        "eventoId": {
          "type": "string",
          "format": "uuid"
        },
        "compradorId": {
          "type": "string",
          "format": "uuid"
        },
        "valorCentavos": {
          "type": "integer",
          "minimum": 0,
          "description": "Valor em CENTAVOS (inteiro). Nunca ponto flutuante."
        },
        "meio": {
          "type": "string",
          "enum": [
            "PIX",
            "CARTAO_CREDITO",
            "BOLETO",
            "CARTAO_RECUSADO"
          ]
        },
        "referenciaPagamento": {
          "type": "string",
          "description": "Token OPACO do meio de pagamento. Nunca o numero do cartao."
        },
        "eventoNome": {
          "type": "string"
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Sai vazia: evento interno da Saga, sem aviso ao usuario."
        }
      },
      "additionalProperties": false
    }
  }
}
