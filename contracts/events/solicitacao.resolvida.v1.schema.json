{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solicitacao.resolvida.v1",
  "title": "SolicitacaoResolvida (v1)",
  "description": "A solicitação foi aceita, recusada ou cancelada pelo próprio solicitante. Publicado por equipes. Consumido por: notificacoes. Routing key: solicitacao.resolvida.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "solicitacao.resolvida"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "equipes"
    },
    "payload": {
      "type": "object",
      "required": [
        "solicitacaoId",
        "equipeId",
        "nomeEquipe",
        "usuarioId",
        "nomeUsuario",
        "status",
        "resolvidoPor",
        "destinatarios"
      ],
      "properties": {
        "solicitacaoId": {
          "type": "string",
          "format": "uuid"
        },
        "equipeId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeEquipe": {
          "type": "string"
        },
        "usuarioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeUsuario": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACEITA",
            "RECUSADA",
            "CANCELADA"
          ]
        },
        "resolvidoPor": {
          "type": "string",
          "format": "uuid"
        },
        "motivo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
