{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pagamento.aprovado.v1",
  "title": "PagamentoAprovado (v1)",
  "description": "Passo 4 da Saga: a cobranca foi autorizada. Publicado por pagamento. Consumido por: ingressos, que emite os ingressos. Routing key: pagamento.aprovado.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "pagamento.aprovado"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "pagamento"
    },
    "payload": {
      "type": "object",
      "required": [
        "pedidoId",
        "transacaoId",
        "eventoId",
        "compradorId",
        "valorCentavos",
        "meio",
        "autorizacao",
        "destinatarios"
      ],
      "properties": {
        "pedidoId": {
          "type": "string",
          "format": "uuid"
        },
        "transacaoId": {
          "type": "string",
          "format": "uuid"
        },
        "eventoId": {
          "type": "string",
          "format": "uuid"
        },
        "compradorId": {
          "type": "string",
          "format": "uuid"
        },
        "valorCentavos": {
          "type": "integer",
          "minimum": 0,
          "description": "Valor em CENTAVOS (inteiro). Nunca ponto flutuante."
        },
        "meio": {
          "type": "string",
          "enum": [
            "PIX",
            "CARTAO_CREDITO",
            "BOLETO",
            "CARTAO_RECUSADO"
          ]
        },
        "autorizacao": {
          "type": [
            "string",
            "null"
          ]
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Sai vazia: evento interno da Saga, sem aviso ao usuario."
        }
      },
      "additionalProperties": false
    }
  }
}
