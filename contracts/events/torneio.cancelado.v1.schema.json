{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "torneio.cancelado.v1",
  "title": "TorneioCancelado (v1)",
  "description": "O torneio foi cancelado. Partidas cancela os jogos pendentes e o Ranking descarta os resultados dele. Publicado por torneios. Consumido por: equipes, partidas, ranking, notificacoes. Routing key: torneio.cancelado.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "torneio.cancelado"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "torneios"
    },
    "payload": {
      "type": "object",
      "required": [
        "torneioId",
        "nomeTorneio",
        "organizadorId",
        "motivo",
        "destinatarios"
      ],
      "properties": {
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeTorneio": {
          "type": "string"
        },
        "organizadorId": {
          "type": "string",
          "format": "uuid"
        },
        "motivo": {
          "type": "string"
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
