{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confrontos.gerados.v1",
  "title": "ConfrontosGerados (v1)",
  "description": "A chave (ou a rodada seguinte) foi sorteada. Partidas cria os jogos; Notificações avisa os integrantes. Publicado por torneios. Consumido por: partidas, notificacoes. Routing key: confrontos.gerados.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "confrontos.gerados"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "torneios"
    },
    "payload": {
      "type": "object",
      "required": [
        "torneioId",
        "nomeTorneio",
        "formato",
        "organizadorId",
        "partidas",
        "destinatarios"
      ],
      "properties": {
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeTorneio": {
          "type": "string"
        },
        "formato": {
          "type": "string",
          "enum": [
            "ELIMINACAO_SIMPLES",
            "PONTOS_CORRIDOS"
          ]
        },
        "organizadorId": {
          "type": "string",
          "format": "uuid"
        },
        "partidas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "partidaId",
              "rodada",
              "equipeAId",
              "nomeEquipeA",
              "equipeBId",
              "nomeEquipeB",
              "capitaoAId",
              "capitaoBId",
              "integrantes"
            ],
            "properties": {
              "partidaId": {
                "type": "string",
                "format": "uuid"
              },
              "rodada": {
                "type": "integer"
              },
              "equipeAId": {
                "type": "string",
                "format": "uuid"
              },
              "nomeEquipeA": {
                "type": "string"
              },
              "equipeBId": {
                "type": "string",
                "format": "uuid"
              },
              "nomeEquipeB": {
                "type": "string"
              },
              "capitaoAId": {
                "type": "string",
                "format": "uuid"
              },
              "capitaoBId": {
                "type": "string",
                "format": "uuid"
              },
              "integrantes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
