{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inscricao.resolvida.v1",
  "title": "InscricaoResolvida (v1)",
  "description": "Desfecho de uma inscrição. Equipes usa para saber se a equipe tem compromisso ativo; Notificações avisa o capitão. Publicado por torneios. Consumido por: equipes, notificacoes. Routing key: inscricao.resolvida.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "inscricao.resolvida"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "torneios"
    },
    "payload": {
      "type": "object",
      "required": [
        "inscricaoId",
        "torneioId",
        "nomeTorneio",
        "equipeId",
        "nomeEquipe",
        "status",
        "destinatarios"
      ],
      "properties": {
        "inscricaoId": {
          "type": "string",
          "format": "uuid"
        },
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeTorneio": {
          "type": "string"
        },
        "equipeId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeEquipe": {
          "type": "string"
        },
        "capitaoId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "CONFIRMADA",
            "REJEITADA",
            "CANCELADA"
          ]
        },
        "motivo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
