{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipe.removida.v1",
  "title": "EquipeRemovida (v1)",
  "description": "A equipe foi desfeita. Torneios cancela as inscrições e libera as vagas. Publicado por equipes. Consumido por: torneios, partidas, ranking, notificacoes. Routing key: equipe.removida.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "equipe.removida"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "equipes"
    },
    "payload": {
      "type": "object",
      "required": [
        "equipeId",
        "nome",
        "capitaoId",
        "motivo",
        "membros",
        "destinatarios"
      ],
      "properties": {
        "equipeId": {
          "type": "string",
          "format": "uuid"
        },
        "nome": {
          "type": "string"
        },
        "capitaoId": {
          "type": "string",
          "format": "uuid"
        },
        "motivo": {
          "type": "string"
        },
        "membros": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
