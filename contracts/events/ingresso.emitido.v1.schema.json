{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingresso.emitido.v1",
  "title": "IngressoEmitido (v1)",
  "description": "Passo 5 da Saga: pagamento aprovado e ingressos digitais emitidos. Publicado por ingressos. Consumido por: notificacoes. Routing key: ingresso.emitido.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "ingresso.emitido"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "ingressos"
    },
    "payload": {
      "type": "object",
      "required": [
        "pedidoId",
        "eventoId",
        "compradorId",
        "eventoNome",
        "eventoDataHora",
        "eventoLocal",
        "totalCentavos",
        "ingressos",
        "destinatarios"
      ],
      "properties": {
        "pedidoId": {
          "type": "string",
          "format": "uuid"
        },
        "eventoId": {
          "type": "string",
          "format": "uuid"
        },
        "compradorId": {
          "type": "string",
          "format": "uuid"
        },
        "eventoNome": {
          "type": "string"
        },
        "eventoDataHora": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "eventoLocal": {
          "type": [
            "string",
            "null"
          ]
        },
        "totalCentavos": {
          "type": "integer",
          "minimum": 0,
          "description": "Valor em CENTAVOS (inteiro). Nunca ponto flutuante."
        },
        "ingressos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ingressoId",
              "codigo",
              "setorNome",
              "loteNome",
              "politica"
            ],
            "properties": {
              "ingressoId": {
                "type": "string",
                "format": "uuid"
              },
              "codigo": {
                "type": "string"
              },
              "setorNome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "loteNome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "politica": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Contem o comprador: ele precisa saber o desfecho."
        }
      },
      "additionalProperties": false
    }
  }
}
