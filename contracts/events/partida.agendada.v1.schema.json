{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partida.agendada.v1",
  "title": "PartidaAgendada (v1)",
  "description": "O organizador definiu ou mudou a data prevista da partida. Publicado por partidas. Consumido por: notificacoes. Routing key: partida.agendada.v1",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "partida.agendada"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "const": "partidas"
    },
    "payload": {
      "type": "object",
      "required": [
        "partidaId",
        "torneioId",
        "nomeTorneio",
        "nomeEquipeA",
        "nomeEquipeB",
        "dataPrevista",
        "destinatarios"
      ],
      "properties": {
        "partidaId": {
          "type": "string",
          "format": "uuid"
        },
        "torneioId": {
          "type": "string",
          "format": "uuid"
        },
        "nomeTorneio": {
          "type": "string"
        },
        "nomeEquipeA": {
          "type": "string"
        },
        "nomeEquipeB": {
          "type": "string"
        },
        "dataPrevista": {
          "type": "string",
          "format": "date-time"
        },
        "destinatarios": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
